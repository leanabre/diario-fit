# ── Supabase ────────────────────────────────────────────────
# Settings → Data API → API URL, PERO SIN el /rest/v1/ del final.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Settings → API Keys → Publishable key (empieza con sb_publishable_).
# Si tu panel todavía muestra el sistema viejo, usá la anon key (empieza con eyJ).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ── Notificaciones (opcional, hace falta estar desplegado) ──
# Generar con: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu@mail.com

# Settings → API Keys → Secret key. NUNCA va en el cliente ni se comparte.
SUPABASE_SECRET_KEY=

# Cualquier string largo. Vercel lo manda en el header del cron.
CRON_SECRET=
